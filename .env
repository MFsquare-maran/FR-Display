# Port, unter dem die Anzeige per HTTP erreichbar ist
PORT=8765
# Flughafen, der bei jedem Laden/Neuladen der Seite startet (ICAO oder IATA, z. B. LSZH, EDDF, KJFK, VIE)
START_ICAO=LSZH
# Ordner auf dem Host, in dem die heruntergeladenen Flughäfen gespeichert werden
CACHE_PATH=/home/maran/serverdata/server/fr-display/cache
